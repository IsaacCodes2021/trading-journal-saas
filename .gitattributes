# Normalize line endings in the repo; checkouts get the platform default.
* text=auto

# Scripts must keep the line endings their shell expects.
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf

# Test fixtures are real exports. Keep their exact bytes (the importer hashes uploaded
# files), so no line-ending conversion on any platform, including the Linux CI runner.
backend/tests/fixtures/*.csv -text

# Binary assets
*.png binary
*.jpg binary
*.gif binary
*.webp binary
