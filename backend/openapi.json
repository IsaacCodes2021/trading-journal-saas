  "info": {
    "title": "Trading Journal API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/accounts": {
      "get": {
        "description": "Every account, by name. Archived ones (passed, failed or closed) are included unless `include_archived=false`.",
        "operationId": "list_accounts",
        "parameters": [
          {
            "in": "query",
            "name": "include_archived",
            "required": false,
            "schema": {
              "default": true,
              "title": "Include Archived",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AccountOut"
                  },
                  "title": "Response List Accounts",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "List Accounts",
        "tags": [
          "accounts"
        ]
      }
    },
    "/api/v1/dashboard": {
      "get": {
        "description": "The headline numbers, equity curves, daily results, score and per-account results for the filtered trades.",
        "operationId": "get_dashboard",
        "parameters": [
          {
            "in": "query",
            "name": "preset",
            "required": false,
            "schema": {
              "default": "all",
              "enum": [
                "all",
                "7d",
                "30d",
                "90d",
                "mtd",
                "last_month",
                "ytd"
              ],
              "title": "Preset",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "in": "query",
