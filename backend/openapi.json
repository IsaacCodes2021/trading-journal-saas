{
  "components": {
    "schemas": {
      "FieldError": {
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "FlagsOut": {
        "properties": {
          "is_admin": {
            "title": "Is Admin",
            "type": "boolean"
          },
          "mfa_fresh": {
            "title": "Mfa Fresh",
            "type": "boolean"
          }
        },
        "required": [
          "is_admin",
          "mfa_fresh"
        ],
        "title": "FlagsOut",
        "type": "object"
      },
      "PlanOut": {
        "properties": {
          "effective": {
            "title": "Effective",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "source": {
            "enum": [
              "override",
              "grant",
              "subscription",
              "free"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "effective",
          "source",
          "expires_at"
        ],
        "title": "PlanOut",
        "type": "object"
      },
      "Problem": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "errors"
        ],
        "title": "Problem",
        "type": "object"
      },
      "SessionOut": {
        "properties": {
          "app_version": {
            "title": "App Version",
            "type": "string"
          },
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "entitlements": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "title": "Entitlements",
            "type": "object"
          },
          "flags": {
            "$ref": "#/components/schemas/FlagsOut"
          },
          "plan": {
            "$ref": "#/components/schemas/PlanOut"
          },
          "settings": {
            "$ref": "#/components/schemas/SettingsOut"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "user",
          "settings",
          "plan",
          "entitlements",
          "flags",
          "csrf_token",
          "app_version"
        ],
        "title": "SessionOut",
        "type": "object"
      },
      "SettingsOut": {
        "properties": {
          "theme": {
            "enum": [
              "dark",
              "light"
            ],
            "title": "Theme",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          },
          "trading_day_start": {
            "title": "Trading Day Start",
            "type": "string"
          },
          "trading_day_timezone": {
            "title": "Trading Day Timezone",
            "type": "string"
          }
        },
        "required": [
          "timezone",
          "trading_day_timezone",
          "trading_day_start",
          "theme"
        ],
        "title": "SettingsOut",
        "type": "object"
      },
      "SettingsPatch": {
        "additionalProperties": false,
        "description": "Only the fields present change; `null` means the same as leaving the field out.",
        "properties": {
          "theme": {
            "anyOf": [
              {
                "enum": [
                  "dark",
                  "light"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Theme"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone"
          },
          "trading_day_start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trading Day Start"
          },
          "trading_day_timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trading Day Timezone"
          }
        },
        "title": "SettingsPatch",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email"
        ],
        "title": "UserOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Trading Journal API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/session": {
      "get": {
        "operationId": "get_session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Get Session",
        "tags": [
          "session"
        ]
      }
    },
    "/api/v1/settings": {
      "patch": {
        "operationId": "patch_settings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Patch Settings",
        "tags": [
          "session"
        ]
      }
    }
  }
}
