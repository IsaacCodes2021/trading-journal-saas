# Your journal data stays local
data/
# ...but the front end's `lib/data` folder is source code (the data-source interface the pages read through).
!frontend/src/lib/data/

# Secrets and local config. Only the template is tracked.
.env
.env.*
!.env.example

# Databases and trade exports are real user data. The only CSVs tracked are the test fixtures.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.csv
!backend/tests/fixtures/*.csv

# NiceGUI local storage
.nicegui/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/

# Node (Phase 2+)
node_modules/
dist/
test-results/
playwright-report/

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
