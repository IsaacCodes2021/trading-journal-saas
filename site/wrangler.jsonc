{
  // The Roundturn site as a Cloudflare Worker with static assets. `npx wrangler deploy` (run by Workers Builds from
  // the `site` folder) reads this file. The name must match the project name in the Cloudflare dashboard.
  "name": "roundturn",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  // The site is served only at its own domain (roundturn.app, attached in the dashboard). Without these two lines a
  // deploy turns the workers.dev address and per-version preview addresses back on: duplicate copies of the site, and
  // an address that carries the account name.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Missing paths get public/404.html with a 404 status.
    "not_found_handling": "404-page",
    // Only /api/* runs code (and only to answer 404: the site has no API). Pages, the stylesheet and the fonts
    // are served straight from the assets.
    "run_worker_first": ["/api/*"]
  },

  // The launch offer pop-up reports what a visitor did with it (shown, closed, copied, sign-up pressed) as the name of an
  // event and nothing else; src/worker.js writes each one as a tally here. Cloudflare makes the dataset the first time it
  // is written to. Read it back with `npm run popup-stats` (needs an API token that can read analytics).
  "analytics_engine_datasets": [{ "binding": "POPUP_EVENTS", "dataset": "roundturn_popup" }]
}
