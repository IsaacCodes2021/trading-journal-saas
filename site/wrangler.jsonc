{
  // The Roundturn site as a Cloudflare Worker with static assets. `npx wrangler deploy` (run by Workers Builds from
  // the `site` folder) reads this file. The name must match the project name in the Cloudflare dashboard.
  "name": "roundturn",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Missing paths get public/404.html with a 404 status.
    "not_found_handling": "404-page",
    // Only the API runs code. Pages, the stylesheet and the script are served straight from the assets.
    "run_worker_first": ["/api/*"]
  },

  // The waitlist. Create the database once in the dashboard (D1) and put its id here; the code creates the table.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roundturn-waitlist",
      "database_id": "2ed2e5b8-9be7-417b-8651-26c712ea3ab9"
    }
  ]
}
